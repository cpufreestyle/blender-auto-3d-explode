{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "layer",
          "responsive",
          "screen"
        ]
      }
    ],
    "selector-class-pattern": null,
    "no-empty-source": null,
    "declaration-block-single-line-max-declarations": null,
    "no-descending-specificity": null,
    "property-no-vendor-prefix": null,
    "declaration-block-no-duplicate-properties": [true, { "ignoreProperties": ["backdrop-filter", "-webkit-backdrop-filter"] }]
  },
  "ignoreFiles": [
    "node_modules/**/*",
    "vendor/**/*"
  ]
}